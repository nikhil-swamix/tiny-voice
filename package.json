    "installer": "tauri build --bundles nsis --features custom-protocol"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "dompurify": "^3.4.16",
    "marked": "^18.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "playwright-core": "^1.64.0",
    "vite": "^7.0.0"
  }
}
